{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::astra-interior-designer-files-022104542793",
      "Condition": {
        "StringLike": {"s3:prefix": "sandboxes/*/render.png"}
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::astra-interior-designer-files-022104542793/sandboxes/*/render.png"
    }
  ]
}
