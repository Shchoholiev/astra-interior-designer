# Local credentials. Use AWS_SECRET_ID instead in deployment.
# OPENAI_API_KEY=
# APP_API_KEY=
# AWS_SECRET_ID=astra-interior-designer/backend

# Local AWS login; omit AWS_PROFILE in deployment to use its IAM role.
AWS_PROFILE=astra-interior-designer
AWS_REGION=us-east-1
SESSIONS_TABLE=astra-interior-designer-sessions
MESSAGES_TABLE=astra-interior-designer-messages
S3_BUCKET=astra-interior-designer-files-022104542793
AGENT_MODEL=gpt-6-astra
CORS_ORIGINS=["http://localhost:3000"]

# Required for compute; the production image/runtime must be published first.
MODAL_IMAGE=astra-blender:v6
MODAL_LAUNCH_COMMAND=["python","/opt/astra/runtime.py","start"]
MODAL_HEALTH_COMMAND=["python","/opt/astra/runtime.py","health"]
MODAL_RECONNECT_COMMAND=["python","/opt/astra/runtime.py","reconnect-executor"]
MODAL_SYNC_INPUTS_COMMAND=["python","/opt/astra/runtime.py","sync-inputs"]
# MODAL_EXECUTOR_SECRET_NAME=
# SANDBOX_S3_ROLE_ARN=

# Optional dedicated signer whose credentials cover the full 12-hour URL lifetime.
# S3_SIGNING_ACCESS_KEY_ID=
# S3_SIGNING_SECRET_ACCESS_KEY=
